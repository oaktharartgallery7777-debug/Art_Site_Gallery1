# Copy to .env and fill in. NEVER commit .env.
# Supabase (existing database)
SUPABASE_URL=https://xyz.supabase.co
SUPABASE_KEY=eyJhbGciOi...

# Cloudinary (existing image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin auth: bcrypt hash of the admin password.
# Generate: python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
# IMPORTANT: docker compose treats $ as a variable. Double every $ in the hash:
#   $2b$12$abc...  ->  $$2b$$12$$abc...
ADMIN_PASSWORD_HASH=

# Random secret for JWT signing (generate: openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRE_HOURS=12

# Public URL of the gallery (used in QR codes), e.g. http://167.172.80.99/gallery
PUBLIC_APP_URL=

ENVIRONMENT=production
